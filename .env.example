# Server
NODE_ENV=development
PORT=8080

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_marketplace

# Redis (optional – falls back to in-memory if not set)
REDIS_URL=redis://localhost:6379

# JWT — change these before deploying!
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=another-long-random-secret-change-before-deploy
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Index number regex (per your institution — default: UG/YYYY/NNNNNN)
INDEX_NUMBER_REGEX=^[A-Z]{2}/\d{4}/\d{6,}$

# Object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=campus-marketplace
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Email (optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@unimarket.edu
